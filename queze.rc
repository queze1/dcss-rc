               tier = 3,
             reason = "Mesmeriser in LOS " .. (check_abil_pct(mons, "Avatar Song") or "buggy") .. "%, equip more Will?"} ,
	      {conditions = {check(mons, "Blink Allies Encircling"), you.branch() ~= "Zig"},
               tier = 2,
             reason = "Encircling blink in LOS, watch out!"} , }

        -- TODO: handle radroach irradiate
        -- TODO: handle ophan "Holy Flames" vs. unholy/undead player check
        -- TODO: handle revenant ghostly fireball (rN check)
        -- TODO: generic "mons carrying randart/unrand check"
        -- TODO: handle Spit Acid and no rCorr
        -- TODO: handle Corrosive Bolt and no rCorr
        -- TODO: look into which other rCorr abilities should be warned
        -- TODO: "if it's unique, and asleep, and at abs(maxlos) from 0,0", auto set an exclude
        -- maybe do the same thing if it's OOD? or tripping any huge damage / rF+++ flags?
        -- TODO: I need to add active status warnings for dangerous player status to this script;
        -- things like petrifying or howl or standing-in-dangerous-cloud or mark
        for _, entry in ipairs(danger_table) do
            assert(type(entry.conditions) == "table" and type(entry.tier) == "number" and type(entry.reason) == "string")
        end
-- end danger table

        for _,threat in ipairs(danger_table) do
            if all_true(threat.conditions) then
                local needs_warn = true
                -- if this entry to current_threats matches a known_threats entry, don't warn about it,
                -- but also delete the matching known_threats entry, so that we can properly warn about duplicate threats.
                for key,entry in pairs(known_threats) do
                    if entry.name == mons:name() and entry.reason == threat.reason then
                        needs_warn = false
                        table.remove(known_threats, key)
                        break
                    end
                end

                table.insert(current_threats, {name = mons:name(), tier = threat.tier, reason = threat.reason, last_warned = nil})
                if needs_warn then self:_warn(current_threats[#current_threats]) end
            end
        end

    end,
    _update_threats = function(self)
        current_threats = {}
        for _,mons in ipairs(mons_table) do
            self:_check_threat(mons)
        end
        if DEBUG_THREATS == true then debug_mpr_current_threats() end

        -- at the end of each update, replace the known_threats table with the current_threats table
        known_threats = current_threats
    end,
    _reissue_warnings = function(self)
        for _,threat in ipairs(current_threats) do
            if threat.tier >= 3 then
                self:_warn(threat, false)
            end
        end
    end,
    _issue_message_log_warnings = function(self)
        for key,warning in ipairs(pending_message_warnings) do
            self:_warn(warning)
            table.remove(pending_message_warnings, key)
        end
    end,
    _update_player_warnings = function(self)
        update_hp_warning()
    end,
    _issue_player_warnings = function(self)
        for key,warning in ipairs(pending_player_warnings) do
            self:_warn(warning,true)
            table.remove(pending_player_warnings, key)
        end
    end,
    _maybe_act = function(self)
-- begin action table
        local action_table = {
        -- TODO: auto-id of consumables, to help avoid earlygame unid situations
        -- TODO: make sure the script autopicks aux items during earlygame
        -- TODO: let the script handle autopick / autodrop of the usual throwables + evo items
        { auto = true, handler = maybe_reissue_autoexplore } , }
-- end action table

        local did_act = nil
        for _,action in ipairs(action_table) do
            if action.auto then
                did_act = action.handler()
            end
            if did_act == true then
                break
            end
        end
        return did_act
    end,
    -- ready() can be called multiple times per game turn, if the player takes actions that do not end the turn.
    -- (e.g. pressing escape, checking inventory with 'i', checking spells with 'I', etc.)
    -- We don't want the script to rebuild threat tables or reissue warnings if it has already done so this turn,
    -- therefore, we only take these actions if the game turn has changed.
    update = function(self)
        if self._last_updated == nil or self._last_updated ~= you.turns() then
            self:_update_mons()
            self:_update_threats()
            --self:_reissue_warnings()
            --self:_update_player_warnings()
            --self:_issue_player_warnings()
            --self._last_updated = you.turns()
        end
        --self:_maybe_act()
    end, }

local message_log_threat_table = {
    {conditions = "into a shaft and drop",
           tier = 3,
         reason = "Shafted!"} ,
    {conditions = "You are yanked towards",
           tier = 3,
         reason = "Malevolent teleportation!"} , }

-- ch_stop_running preempts(?) c_message, so here we track state, and defer acting on it until the next ready().
-- TODO: check messages for whether the player was shafted / teleported, and if so, stop reissuing autoexplore?
-- I don't want the script blindly re-issuing actions if the floor situation has changed.
function c_message(text, channel)
    if string.find(text, "Done exploring.") then done_exploring = true end
    if string.find(text, "Partly explored") then done_exploring = true end

    for _,threat in ipairs(message_log_threat_table) do
        if string.find(text, threat.conditions) then
            table.insert(pending_message_warnings, {name = threat.reason, tier = threat.tier, reason = threat.reason, last_warned = nil})
            status:_issue_message_log_warnings() 
       end
    end
end

-- Does the given feature exist adjacent to the player?
--
-- For this, we compare against view.feature_at(x,y),
-- which returns the second name string in feature-data.h, feature_def feat_defs[],
-- this is the "vaultname" string that includes underscores.
--
-- If ignore_excluded is true, we treat tiles with exclusions as though they do not contain the feature.
-- @param string "feature_name"
-- @param bool[opt="false"] ignore_excluded
-- @return bool
function check_adjacent_feat(string, ignore_excluded)
    ignore_excluded = ignore_excluded or false
    local feature = nil
    for i = -1,1 do
        for j = -1,1 do
            feature = view.feature_at(i,j)
            if feature == string then
                if ignore_excluded == true and travel.is_excluded(i,j) == true then
                    -- do nothing, continue the loop
                else
                    return true
                end
            end
        end
    end
    return false
end

-- Note: We can't print messages to mpr from ch_stop_running().
-- XXX: Messages here appear to print to the log *before* the c_message() hook is called, which appears
-- to preempt that hook, breaking the underlying assumption that it's being called for each message. (???)
function ch_stop_running(runmode)
    reissue_autoexplore_needed = false
    -- These conditions test if our autoexplore was interrupted early due to travel_open_doors = avoid.
    -- XXX: This check is imperfect, and is likely to send the script into infinite autoexplore loops.
    -- I've added an assert and some harder checks to maybe_reissue_autoexplore(), but this could still be improved.
    if runmode == "explore_greedy" and check_adjacent_feat("closed_door", true)
       and you.feel_safe() and force_autoexplore_stop == false then
           reissue_autoexplore_needed = true
    end
end

-- "travel_open_doors = avoid" ordinarily causes problems with closed doors and interlevel travel.
-- This permits autotravel to open doors that are in the way, when issuing G> and X> commands.
function ch_start_running(runmode)
    if runmode == "intertravel" then
        crawl.setopt("travel_open_doors = open")
    end
end

-- end threat warning lua


-- begin helper lua

-- Helper function calculating distance from player
function DistToPlayer(x, y)
  return math.abs(x) + math.abs(y)
end

-- Helper function generating all coords in LOS
function LOSCoords()
  local x, y
  local coords = {}
  for x = -you.los(), you.los() do
    for y = -you.los(), you.los() do
	  table.insert(coords, {x = x, y = y})
	end
  end
  return coords
end

-- Helper function returning true if a feature is an upstairs
function IsUpstair(feature)
  if feature == nil then
    return false
  elseif string.find(feature, "stairs_up") then
    return true
  elseif string.find(feature, "escape_hatch_up") then
    return true
  elseif string.find(feature, "exit_") then
    return true
  end
  return false
end

-- Helper function returning true if a feature is a downstairs
function IsDownstair(feature)
  return string.find(feature, "stairs_down")
end

-- Helper function returning true if a hostile creature is in LOS
function IsEnemyInLOS()
  for _, c in ipairs(LOSCoords()) do
    m = monster.get_monster_at(c.x, c.y)
    -- 0 = hostile, 1 = neutral, 2 = friendly
    if m and m:attitude() < 1 and not m:is_safe() then
      return true
    end
  end
  return false
end

-- Helper function returning true if you are completely rested
function IsHealthy()
  hp, mhp = you.hp()
  mp, mmp = you.mp()
  if hp < mhp then
    return false
  elseif mp < mmp then
    return false
  elseif you.contaminated() ~= 0 then
    return false
  end
  return true
end

-- Helper function returning true if it's safe to rest
function IsSafe()
  local feature = view.feature_at(0, 0)
  hp, mhp = you.hp()
  mp, mmp = you.mp()
  if IsUpstair(feature) then
    return true
  end
  return IsHealthy()
end

-- Helper function which finds a message in the buffer which contains a pattern
-- If a message matches the stop pattern, then return nil
function FindMessage(match, stop)
  local counter = 1
  -- Check at most 100 messages
  while (counter < 100)
  do
    message = crawl.messages(counter)
    counter = counter + 1

    if string.find(message, match) then
      return message
    end
    if string.find(message, stop) then
      return
    end
  end
end

-- end helper lua


-- Hold alt when walking to shout before walking and stop if any monsters shout back
local noise_warning = false
local last_action
local next_direction
local direction_to_coord = {["y"]={-1, -1},
                            ["u"]={1, -1},
                            ["h"]={-1, 0},
                            ["b"]={-1, 1},
                            ["n"]={1, 1},
                            ["j"]={0, 1},
                            ["k"]={0, -1},
                            ["l"]={1, 0}}

-- Creates a shout walk function for a direction
-- Shouts, then sets up the states for ShoutWalkManager
function ShoutWalkCreator(direction)
  return function()
    -- Do not shout walk if monsters are in LOS.
    if IsEnemyInLOS() then
      crawl.mpr("There are monsters nearby!", 5)
      return
    end
    -- If a monster has made a noise in the last shout walk,
    -- prompt whether to shout walk anyway
    if noise_warning then
      if not crawl.yesno("Your last walk was canceled because a monster made a noise. Continue anyway?") then
        return
      end
    end

    -- Shout, then set last_action to shout and set the walking direction
    crawl.sendkeys("tt")
    last_action = "shout"
    next_direction = direction
  end
end

-- Manages the state tracking
function ShoutWalkManager()
  -- Reset the noise warning at the start of every turn
  noise_warning = false
  
  if not last_action then
    return
  end

  -- Abort if an enemy is in LOS
  if IsEnemyInLOS() then
    crawl.mpr("A monster has walked into LOS. Walk canceled.", 3)
	last_action = nil
    return
  end

  -- If last action was shouting, then attempt to walk
  if last_action == "shout" then
    local message
    local finished = false
	-- Finds a message with "You hear", stopping when one is found with "for attention"
    local noise_made = FindMessage("You hear", "for attention")
		
    -- Abort if a noise was made
    if noise_made then
      crawl.mpr("A noise has been made in response. Walk canceled.", 3)
      noise_warning = true
      last_action = nil
      return
    end
	
    -- Abort if path is blocked
    -- local x, y = direction_to_coord[next_direction][1], direction_to_coord[next_direction][2]
	
    -- Abort if path is interrupted

    -- Walk and set last_action
    crawl.sendkeys(next_direction)
    -- add terrain check
    --last_action = "walk"
    last_action = nil
   
  -- If last_action is walk, then shout
  elseif last_action == "walk" then
    -- crawl.sendkeys("tt")
    -- last_action = "shout"
    return
  end
end

function ShoutWalkMapper()
  shout_walk_y = ShoutWalkCreator("y")
  shout_walk_u = ShoutWalkCreator("u")
  shout_walk_h = ShoutWalkCreator("h")
  shout_walk_b = ShoutWalkCreator("b")
  shout_walk_n = ShoutWalkCreator("n")
  shout_walk_j = ShoutWalkCreator("j")
  shout_walk_k = ShoutWalkCreator("k")
  shout_walk_l = ShoutWalkCreator("l")
end

-- Set up shout walk functions
ShoutWalkMapper()


-- Safe exploring
local retreated = false
function SafeExplore()
  -- Do not allow exploring if you have a sentinel's mark
  -- Not sure why you.status() doesn't work
  if FindMessage("mark forms upon you", "mark upon you fades away") then
    crawl.mpr("<lightred>A sentinel's mark is upon you!<lightred>")
	
  elseif IsSafe() or retreated then
    -- Links to reissue autoexplore code
    crawl.setopt("travel_open_doors = avoid")
    force_autoexplore_stop = false
    crawl.do_commands({"CMD_EXPLORE"})
    retreated = false
  
  -- If you are not safe, then prompt to retreat
  else
    retreated = true
  
    for _, c in ipairs(LOSCoords()) do
      if IsUpstair(view.feature_at(c.x, c.y)) then
	    crawl.sendkeys("X<")
		return
	  end
	end  
    crawl.sendkeys("X")
  end
end

-- Prompts when going downstairs when not full hp/full mp/no magic contamination
-- TODO: Allow going downstairs when not at full MP when ADead/DChan is applied
function SafeDownstairs()
  if not IsDownstair(view.feature_at(0, 0)) then
    crawl.do_commands({"CMD_GO_DOWNSTAIRS"})
  elseif IsSafe() then
    crawl.do_commands({"CMD_GO_DOWNSTAIRS"})
  elseif crawl.yesno("Really go downstairs while injured?") then
    crawl.do_commands({"CMD_GO_DOWNSTAIRS"})
  end
end


-- If an enemy is in LOS while going upstairs, exclude all upstairs in LOS as dangerous before going
local ignore_upstair_exclusion = false

function SafeUpstairs()
  -- If not on upstairs, trigger default error message
  if not IsUpstair(view.feature_at(0, 0)) then
    crawl.do_commands({"CMD_GO_UPSTAIRS"})
    return
  end

  for _, c in ipairs(LOSCoords()) do
    if IsUpstair(view.feature_at(c.x, c.y)) and view.cell_see_cell (0, 0, c.x, c.y) then
      if IsEnemyInLOS() then
        travel.set_exclude(c.x, c.y, 2)
        -- Temporarily ignore "This staircase is marked as excluded" for this turn
        ignore_upstair_exclusion = true
      end
    end
  end

  crawl.do_commands({"CMD_GO_UPSTAIRS"})
end


-- Remove all exclusions on upstairs in LOS if no enemy is in LOS
function RemoveUpstairExclusions()
  for _, c in ipairs(LOSCoords()) do
    if IsUpstair(view.feature_at(c.x, c.y)) and view.cell_see_cell (0, 0, c.x, c.y) then
      if not IsEnemyInLOS() then
        travel.del_exclude(c.x, c.y)
      end
    end
  end
end


-- Repurpose (w)ield for spellcasting, but only for felids
function FelidZF()
  if you.race() == "Felid" then
    crawl.sendkeys("zf")
  else
    crawl.do_commands({"CMD_WIELD_WEAPON"})
  end
end


-- Opens skill menu at the beginning of the game
local need_skills_opened = true
function OpenSkills()
  if you.turns() == 0 and need_skills_opened then
    need_skills_opened = false
    crawl.sendkeys("m")
  end
end


-- Equipment autopickup
-- Do not pick up duplicates of a dropped non-artifact ring
-- TODO: Extend drop check to armour, if branded AND (same type as item in inventory AND enchantment is lower) OR (ego has been dropped) then don't pick up
-- TODO: Extend to weapons too, checking weapon category, if same category then same as previous checks, if diff category only if artifact

-- Resets dropped rings at the start of each game
if you.turns() == 0 or c_persist.dropped_rings == nil then
  c_persist.dropped_rings = {}
end

-- Light (0): 0-4, Medium (1): 5-11, Heavy (2): 12-99
function WeightClass(it)
  if it == nil then
    return 0
  elseif it.encumbrance <= 4 then
    return 0
  elseif it.encumbrance <= 11 then
    return 1
  else
    return 2
  end
end

-- None: 0, Plain: 1, Branded: 2, Artifact: 3
function RarityClass(it)
  if it == nil then
    return 0
  elseif it.artifact then
    return 3
  elseif it.branded then
    return 2
  else
    return 1
  end
end

function autopickup(it, name)
  if it.is_useless then
    return
  end
  
  local class = it:class(true)
  if class == "Armour" then
    local cur = items.equipped_at(it.equip_type)

    -- Pickup armour of the same weight class, if it has equal or higher rarity
    local equal_weight = WeightClass(it) == WeightClass(cur)
    local greater_rarity = RarityClass(it) >= RarityClass(cur)
    if equal_weight and greater_rarity then
      return true
    end
  elseif class == "Jewellery" and c_persist.dropped_rings[it:ego()] ~= nil then
    return false
  end
end

function DropItem()
  crawl.do_commands({"CMD_DROP"})
  if you.floor_items() == nil then
    return
  end

  for _, it in ipairs(you.floor_items()) do
    if not it.artifact and it:class(true) == "Jewellery" and it.dropped then
      c_persist.dropped_rings[it:ego()] = true
    end
  end
end

function DebugAutopickup()
    if you.floor_items() == nil then
    return
  end

  for _, it in ipairs(you.floor_items()) do
    local cur = items.equipped_at(it.equip_type)
    local class = it:class(true)
    if class == "Armour" then
      crawl.mpr("Item's weight class: ".. WeightClass(it))
      crawl.mpr("Current weight class: ".. WeightClass(cur))
      crawl.mpr("Current rarity class: ".. RarityClass(cur))
      crawl.mpr("Item's rarity class: ".. RarityClass(it))
    elseif class == "Jewellery" then
      local isDropped = c_persist.dropped_rings[it:ego()] ~= nil
      local isDroppedMsg = isDropped and "has" or "has not"
      crawl.mpr(it:ego() .. " " .. isDroppedMsg .. " been dropped.")
    end
  end
end


function c_answer_prompt(prompt)
    -- skip chain lightning and shatter ally prompts when megazigging with death channel
    if you.branch() == "Zig" and you.status("death channelling") == true then
        if prompt:find("Chain Lightning might hit") then return true end
        if prompt:find("Really attack near") then return true end
    end
    if prompt:find("Really quaff the potion of lignification") then return true end
    if prompt:find("Really attack barehanded") then return true end
    if prompt:find("Shopping list: replace") then return false end
    if prompt:find("Shopping list: remove") then return false end
    -- try to prevent the script from becoming stuck in a failed autopickup -> reissue autoexplore loop,
    -- if it fails to pick something up while adjacent to a closed door
    if prompt:find("Could not pick up") then
        force_autoexplore_stop = true
    end

    -- skip exclusion prompt from SafeUpstairs
    if prompt:find("Enter next level anyway") and FindMessage("This staircase is marked as excluded", "There is a") and ignore_upstair_exclusion then
      ignore_upstair_exclusion = false
      return true
    end
end


function ready()
  AnnounceDamage()
  OpenSkills()

  ShoutWalkManager()
  RemoveUpstairExclusions()

  --threat warning
  if DEBUG_YOU_STATUS == true then crawl.mpr(you.status() .. " || " .. you.transform()) end
  status:update()
end
}

######################################################################
#                          General Settings                          #
######################################################################

# Sets skill training to manual
default_manual_training = true

# Force uppercase Y on dangerous questions
easy_confirm            = safe

# 'W'ear will also allow you to 'T'ake off worn armour, and vice versa, and the same is true for 'P'utting on / 'R'emoving jewellery
equip_unequip           = true

# How long auto-explore waits after each move (milliseconds)
explore_delay           = -1

hp_colour               = 100:green, 99:lightgrey, 75:yellow, 50:lightred, 25:red

mp_colour               = 100:green, 99:lightgrey, 75:yellow, 50:lightred, 25:red

# Logs chat messages into the notes
note_chat_messages      = true

# How long resting waits after each move (milliseconds)
rest_delay              = -1

# If true, only stop resting when both HP/MP are full
rest_wait_both          = true

# Try it. Shows 'more' prompts when outputting more than one screen of messages
show_more               = false

# Highlights the path taking during autoexplore or travel
show_travel_trail       = true

# If true, disables smart targeting for explosion and bouncing bolt spells
simple_targeting        = false

# Items are sorted according to: equipped, basename, qualname, curse, qty
sort_menus              = true

stat_colour             = 3:red, 7:lightred

# How long travel waits after each move (milliseconds)
travel_delay            = -1

# Prefixes manually added notes with the -- string, to make them easier to find
user_note_prefix        = --

# Controls the speed of animations
view_delay              = 100

# Adjusts how much autoexplore favours attempting to discover room perimeters and corners.
# At values higher than 0, autoexplore will more heavily favour visiting squares that are next to walls
# reasonable values range from 0 to 10 maybe?
# Try it.
#explore_wall_bias       = 3

## Implojin
prompt_menu = false
# try to prevent autopick from being interrupted during zig cleanup?
travel_key_stop = false
