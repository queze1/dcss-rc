        {conditions = {check_abil_pct(mons, "Sentinel's Mark") ~= nil and check_abil_pct(mons, "Sentinel's Mark") > 5},
               tier = 3,
             reason = "Sentinel's Mark " .. (check_abil_pct(mons, "Sentinel's Mark") or "buggy") .. "%, equip more Will?"} ,
        -- comparing "distort" instead of "distortion" works against Rift, randarts, and panlord "distorting touch"
        -- TODO: check to see if this catches dancing weapons?
        {conditions = {check_tdesc(mons, "[dD]istort"), you.branch() ~= "Zig"},
               tier = 3,
             reason = "Distortion weapon!"} ,
        -- elec weapons: ego, randarts + glaive of the guard + eos + storm bow, arc blade
        {conditions = {check_tdesc(mons, "of electrocution")
                       or check_tdesc(mons, "{elec")
                       or check_tdesc(mons, "arc blade"),
                       you.res_shock() < 1, you.branch() ~= "Zig"},
               tier = 2,
             reason = "Electrocution weapon and no rElec!"} ,
        {conditions = {check_tdesc(mons, "quivering poison"), you.res_poison() < 1, you.branch() ~= "Zig"},
               tier = 2,
             reason = "Quivering poison darts and no rPois, careful!"} ,
        {conditions = {check_tdesc(mons, "quivering curare"), you.res_poison() < 1, you.branch() ~= "Zig"},
               tier = 3,
             reason = "Quivering curare and no rPois, watch out!!"} ,
        {conditions = {check_tdesc(mons, "quivering atropa"), you.branch() ~= "Zig"},
               tier = 2,
             reason = "Quivering atropa, careful!"} ,
        {conditions = {check_tdesc(mons, "quivering datura"), you.branch() ~= "Zig"},
               tier = 3,
             reason = "Quivering datura, careful!"} ,
        {conditions = {check_tdesc(mons, "quivering dispersal"), you.branch() ~= "Zig"},
               tier = 3,
             reason = "Quivering dispersal, careful!"} ,
        {conditions = {check_tdesc(mons, "throwing net"), you.branch() ~= "Zig"},
               tier = 3,
             reason = "Quivering throwing nets, watch out!"} ,
        -- TODO: branded javelins (silver), branded large rocks (chuck)
        {conditions = {check_tdesc(mons, "large rock"), you.branch() ~= "Zig"},
               tier = 2,
             reason = "Quivering large rocks, watch out!!"} ,
        {conditions = {check_tdesc(mons, "javelin"), you.branch() ~= "Zig"},
               tier = 2,
             reason = "Quivering javelins, watch out!"} ,
        {conditions = {check_tdesc(mons, "boomerang"), you.branch() ~= "Zig"},
               tier = 2,
             reason = "Quivering boomerangs, careful!"} ,
        {conditions = {check(mons, "Malmutate"), you.branch() ~= "Zig"},
               tier = 2,
             reason = "Malmutator in LOS"} ,
        -- XXX: I'd prefer to check lof against "Malmutate" here, but it seems like spells.path() only works with player spells?
        {conditions = {check(mons, "Malmutate"), check_lof(mons), you.branch() ~= "Zig"},
               tier = 2,
             reason = "Malmutator in LOF!"} ,
        {conditions = {mons:name() == "orb of fire", you.res_fire() < 3},
               tier = 3,
             reason = "Orb of Fire and low rF"} ,
        {conditions = {mons:is_unique() == true},
               tier = 2,
             reason = "Unique monster, careful!"} ,
        {conditions = {check_rare_ood(mons)},
               tier = 2,
             reason = "OOD monster, careful!"} ,

        {conditions = {mons:name() == "Nikola", you.res_shock() < 1},
               tier = 3,
             reason = "Nikola and no rElec"} ,
        {conditions = {mons:name() == "Nikola", check_tdesc(mons, "[sS]ilenced") ~= true and mons:status("waterlogged") ~= true},
               tier = 3,
             reason = "Nikola in LOS and not silenced or waterlogged"} ,

        -- ironbound thunderhulks, lodul
        {conditions = {check(mons, "Call Down Lightning"), you.res_shock() < 1},
               tier = 3,
             reason = "Call Down Lightning and no rElec"} ,

        {conditions = {string.find(mons:name(), "[sS]imulacrum") ~= nil, you.res_cold() < 1},
               tier = 2,
             reason = "simulacrum and no rC, careful"} ,
        {conditions = {string.find(mons:name(), "[sS]imulacrum") ~= nil, string.find(mons:speed_description(), "fast") ~= nil,
                       you.res_cold() < 1},
               tier = 3,
             reason = mons:speed_description() .. " simulacrum and no rC, watch out!!"} ,

        {conditions = {mons:is("ready_to_howl"), you.branch() ~= "Zig",
                       check_abil_pct(mons, "Doom Howl") ~= nil and check_abil_pct(mons, "Doom Howl") > 5},
               tier = 3,
             reason = "Doom Howl " .. (check_abil_pct(mons, "Doom Howl") or "buggy") .. "%, equip more Will or hex it or something"} ,
        {conditions = {check(mons, "Symbol of Torment"), not you.torment_immune()},
               tier = 3,
             reason = "Torment and not torment immune!"} ,

        {conditions = {check(mons, "Dispel Undead Range"), you_are_undead(true) == true},
               tier = 3,
             reason = "Dispel Undead in LOS while undead!"} ,
        {conditions = {check_tdesc(mons, "Undeadhunter"), you_are_undead(true) == true},
               tier = 3,
             reason = "wielding Undeadhunter while undead, watch out!!"} ,
        {conditions = {check_tdesc(mons, "holy wrath"), you_are_unholy() == true},
               tier = 3,
             reason = "wielding holy wrath while unholy, watch out!!"} ,

        {conditions = {check_tdesc(mons, "carrying a wand")},
               tier = 2,
             reason = "carrying a " .. (string.match(mons:target_desc(), "wand of %w+") or "unknown/nonexistent wand?")
                                    .. ", careful!"} ,
        -- damnation checks
        {conditions = {check(mons, "Hurl Damnation")},
               tier = 2,
             reason = "Damnation in LOS, careful!"} ,
        {conditions = {check(mons, "Call Down Damnation")},
               tier = 2,
             reason = "Damnation (smite) in LOS, watch out!"} ,

        -- by me
        {conditions = {check(mons, "Smiting"), you.hp() < 50},
               tier = 2,
             reason = "Smiter in LOS and HP below 50, watch out!"} ,
        {conditions = {check(mons, "Blink Allies Encircling")},
               tier = 2,
             reason = "Encircling blink in LOS, watch out!"} ,
        {conditions = {check(mons, "Siphon Essence"), not you.torment_immune()},
               tier = 3,
             reason = "Siphon Essence (torment) and not torment immune!"} , }

        -- TODO: handle radroach irradiate
        -- TODO: handle ophan "Holy Flames" vs. unholy/undead player check
        -- TODO: handle revenant ghostly fireball (rN check)
        -- TODO: generic "mons carrying randart/unrand check"
        -- TODO: handle Spit Acid and no rCorr
        -- TODO: handle Corrosive Bolt and no rCorr
        -- TODO: look into which other rCorr abilities should be warned
        -- TODO: "if it's unique, and asleep, and at abs(maxlos) from 0,0", auto set an exclude
        -- maybe do the same thing if it's OOD? or tripping any huge damage / rF+++ flags?
        -- TODO: I need to add active status warnings for dangerous player status to this script;
        -- things like petrifying or howl or standing-in-dangerous-cloud or mark

        for _,entry in ipairs(danger_table) do
            assert(type(entry.conditions) == "table" and type(entry.tier) == "number" and type(entry.reason) == "string")
        end
-- end danger table

        for _,threat in ipairs(danger_table) do
            if util.forall(threat.conditions, function(value) return value == true end) then
                local needs_warn = true
                -- if this entry to current_threats matches a known_threats entry, don't warn about it,
                -- but also delete the matching known_threats entry, so that we can properly warn about duplicate threats.
                for key,entry in pairs(known_threats) do
                    if entry.name == mons:name() and entry.reason == threat.reason then
                        needs_warn = false
                        table.remove(known_threats, key)
                        break
                    end
                end

                table.insert(current_threats, {name = mons:name(), tier = threat.tier, reason = threat.reason, last_warned = nil})
                if needs_warn then self:_warn(current_threats[#current_threats]) end
            end
        end

    end,
    _update_threats = function(self)
        current_threats = {}
        for _,mons in ipairs(mons_table) do
            self:_check_threat(mons)
        end
        if DEBUG_THREATS == true then debug_mpr_current_threats() end

        -- at the end of each update, replace the known_threats table with the current_threats table
        known_threats = current_threats
    end,
    _reissue_warnings = function(self)
        for _,threat in ipairs(current_threats) do
            if threat.tier >= 3 then
                self:_warn(threat, false)
            end
        end
    end,
    _issue_message_log_warnings = function(self)
        local warnings = pending_message_warnings
        pending_message_warnings = {}
        for _,warning in ipairs(warnings) do
            self:_warn(warning)
        end
    end,
    _update_player_warnings = function(self)
        update_hp_warning()
    end,
    _issue_player_warnings = function(self)
        for key,warning in ipairs(pending_player_warnings) do
            self:_warn(warning,true)
            table.remove(pending_player_warnings, key)
        end
    end,
    -- ready() can be called multiple times per game turn, if the player takes actions that do not end the turn.
    -- (e.g. pressing escape, checking inventory with 'i', checking spells with 'I', etc.)
    -- We don't want the script to rebuild threat tables or reissue warnings if it has already done so this turn,
    -- therefore, we only take these actions if the game turn has changed.
    update = function(self)
        if self._last_updated == nil or self._last_updated ~= you.turns() then
            self:_update_mons()
            self:_update_threats()
            self:_reissue_warnings()
            self:_update_player_warnings()
            self:_issue_player_warnings()
            self._last_updated = you.turns()
        end
    end, }

local message_log_threat_table = {
    {conditions = "into a shaft and drop",
           tier = 3,
         reason = "Shafted!"} ,
    {conditions = "You are yanked towards",
           tier = 3,
         reason = "Malevolent teleportation!"} , }

function IssueMessageWarnings(text)
    for _,threat in ipairs(message_log_threat_table) do
        if string.find(text, threat.conditions) then
            table.insert(pending_message_warnings, {name = threat.reason, tier = threat.tier, reason = threat.reason, last_warned = nil})
            status:_issue_message_log_warnings() 
       end
    end
end

function WarnThreats()
    status:update()
end
}

######################################################################
#                        Custom Lua Functions                        #
######################################################################

{
-- =========================
-- HELPER FUNCTIONS
-- =========================

-- Helper function generating all coords in LOS
function LOSCoords()
  local coords = {}
  for x = -you.los(), you.los() do
    for y = -you.los(), you.los() do
	  table.insert(coords, {x = x, y = y})
	end
  end
  return coords
end

-- Helper function returning true if a hostile creature is in LOS
function IsEnemyInLOS()
  return util.exists(LOSCoords(), function(c)
    local m = monster.get_monster_at(c.x, c.y)
    -- 0 = hostile, 1 = neutral, 2 = strict neutral, 3 = good neutral, 4 = friendly
    return m and m:attitude() < 1 and not m:is_safe()
  end)
end

-- Helper function which finds a message in the buffer containing a pattern
-- If a subsequent message matches the stop pattern, return nil
function FindMessage(match, stop)
  local counter = 1
  -- Check at most 100 messages
  while (counter < 100)
  do
    local message = crawl.messages(counter)
    counter = counter + 1

    if string.find(message, match) then
      return message
    end
    if string.find(message, stop) then
      return
    end
  end
end

-- Helper function returning true if you are completely rested
function IsHealthy()
  local hp, mhp = you.hp()
  local mp, mmp = you.mp()
  if hp < mhp then
    return false
  elseif mp < mmp then
    return false
  elseif you.contamination() > 0 then
    return false
  end
  return true
end

-- Helper function returning true if a feature is an upstair
function IsUpstair(feature)
  if feature == nil then
    return false
  elseif string.find(feature, "stairs_up") then
    return true
  elseif string.find(feature, "escape_hatch_up") then
    return true
  elseif string.find(feature, "exit_") then
    return true
  end
  return false
end

-- Helper function returning true if a feature is an downstair 
function IsDownstair(feature)
  if feature == nil then
    return false
  elseif string.find(feature, "enter_shop") then
    return false
  elseif string.find(feature, "stairs_down") then
    return true
  elseif string.find(feature, "escape_hatch_down") then
    return true
  elseif string.find(feature, "enter_") then
    return true
  end
  return false
end

-- Helper function returning true if it's safe to autoexplore
function IsSafe()
  local feature = view.feature_at(0, 0)
  if IsUpstair(feature) then
    return true
  end

  local hp, mhp = you.hp()
  local mp, mmp = you.mp()
  return hp == mhp and mp == mmp
end

-- =========================
-- EXPLORATION
-- =========================

local retreated = false

function SafeExplore()
  -- Do not allow exploring if you have a sentinel's mark
  -- Not sure if you.status() works now
  if FindMessage("mark forms upon you", "mark upon you fades away") then
    crawl.mpr("<lightred>A sentinel's mark is upon you!</lightred>")
	
  elseif IsSafe() or retreated then
    crawl.do_commands({"CMD_EXPLORE"})
    retreated = false
  
  else
    retreated = true
  
    -- If possible, retreat to a stair
    for _, c in ipairs(LOSCoords()) do
      if IsUpstair(view.feature_at(c.x, c.y)) then
	    crawl.sendkeys("X<")
		return
	  end
	end  

    -- Otherwise, open level map
    crawl.sendkeys("X")
  end
end

-- =========================
-- SHOUT WALKING
-- =========================

-- Shout before walking and stop if any monsters shout back
local ask_for_confirmation = true
local noise_warning = false
local last_action
local next_direction

-- Create a shout walk function for a direction
function ShoutWalkCreator(direction)
  return function()
    -- Do not shout walk if monsters are in LOS
    if IsEnemyInLOS() then
      crawl.mpr("There are monsters nearby!", 5)
      return
    end

    -- If a monster has made a noise in the last shout walk, prompt whether to shout walk anyway
    if noise_warning then
      if not crawl.yesno("Your last walk was canceled because a monster made a noise. Continue anyway?") then
        return
      end
    end

    -- Shout walking is dangerous, ask to confirm
    if ask_for_confirmation then
      if not crawl.yesno("Really shout walk? This will wake up nearby monsters!") then
        return
      end
      ask_for_confirmation = false
    end

    -- Shout, then set direction for next turn
    crawl.sendkeys("tt")
    last_action = "shout"
    next_direction = direction
  end
end

-- Manages the state tracking
function ShoutWalkManager()
  local direction = next_direction
  local action = last_action
  noise_warning = false
  next_direction = nil
  last_action = nil

  -- Ask for confirmation again between shout walks
  if action == nil then
    ask_for_confirmation = true
  end

  -- Skip if no direction was set, or if we didn't shout last turn
  if direction == nil or action ~= "shout" then
    return
  end
  
  -- Abort if an enemy is in LOS
  if IsEnemyInLOS() then
    crawl.mpr("A monster has walked into LOS. Walk canceled.", 3)
    return
  end

  -- Abort if a noise was made
  local noise_made = FindMessage("You hear", "for attention")
  if noise_made then
    crawl.mpr("A noise has been made in response. Walk canceled.", 3)
    noise_warning = true
    return
  end
  
  -- Walk in the direction set last turn
  crawl.sendkeys(direction)
  last_action = "walk"
end

function ShoutWalkMapper()
  shout_walk_y = ShoutWalkCreator("y")
  shout_walk_u = ShoutWalkCreator("u")
  shout_walk_h = ShoutWalkCreator("h")
  shout_walk_b = ShoutWalkCreator("b")
  shout_walk_n = ShoutWalkCreator("n")
  shout_walk_j = ShoutWalkCreator("j")
  shout_walk_k = ShoutWalkCreator("k")
  shout_walk_l = ShoutWalkCreator("l")
end

-- Set up shout walk functions
ShoutWalkMapper()

-- =========================
-- STAIR SAFETY
-- =========================

local mark_return_stair

function SafeUpstairs()
  id_warn() -- from rypo

  local feature = view.feature_at(0, 0)

  -- Warn before using an escape hatch
  if string.find(feature, "escape_hatch_up") then
    if not crawl.yesno("Really use the escape hatch?") then
      return
    end
  end

  mark_return_stair = IsUpstair(feature) and IsEnemyInLOS()
  crawl.do_commands({"CMD_GO_UPSTAIRS"})
end

-- Save a downstair in waypoint 9, if enemies were in LOS when going upstairs
function MarkReturnStair()
  if not mark_return_stair then
    return
  end

  if IsDownstair(view.feature_at(0, 0)) then
    crawl.mpr("<lightred>Staircase saved. Enemies were in view.</lightred>")
    travel.set_waypoint(9, 0, 0)
  end

  mark_return_stair = false
end

-- Prompt when going downstairs in dangerous situations
function SafeDownstairs()
  id_warn() -- from rypo

  if not IsDownstair(view.feature_at(0, 0)) then
    crawl.do_commands({"CMD_GO_DOWNSTAIRS"})
    return
  end

  local return_stair_x, return_stair_y = travel.waypoint_delta(9)
  if return_stair_x == 0 and return_stair_y == 0 then
    if not crawl.yesno("Really use the return stair? Enemies were in view.") then
      return
    end
  end

  local branch = you.branch()
  local depth = you.depth()
  local deepest_current = travel.find_deepest_explored(branch) or 0
  local deepest_depths = travel.find_deepest_explored("Depths") or 0

  -- Prevent going to Vaults:5 before Depths
  if branch == "Vaults" and depth == 4 and deepest_depths == 0 then
    crawl.mpr("<lightred>Visit Depths before doing Vaults:5, please.</lightred>")
    return
  end

  -- Warn before going to V:5 for the first time
  if branch == "Vaults" and depth == 4 and deepest_current < 5 then
    if crawl.yesno("Are you really prepared to enter Vaults:5?") then
      crawl.do_commands({"CMD_GO_DOWNSTAIRS"})
      return
    end
  end

  local s_branches = {"Shoals", "Swamp", "Snake", "Spider"}
  local in_s_branch = util.contains(s_branches, branch)

  -- Warn before entering the fourth floor of an S-branch for the first time before exploring another
  if in_s_branch and depth == 3 and deepest_current < 4 then
    local explored_another_s_branch = util.exists(s_branches, function(s_branch)
      return s_branch ~= branch
        and (travel.find_deepest_explored(s_branch) or 0) > 0
    end)

    if not explored_another_s_branch then
      if crawl.yesno("Really go downstairs to the last level before exploring another S-branch?") then
        crawl.do_commands({"CMD_GO_DOWNSTAIRS"})
      end
      return
    end
  end

  -- Warn before using an escape hatch
  if string.find(view.feature_at(0, 0), "escape_hatch_down") then
    if not crawl.yesno("Really use the escape hatch?") then
      return
    end
  end

  if IsHealthy() then
    crawl.do_commands({"CMD_GO_DOWNSTAIRS"})
  elseif crawl.yesno("Really go downstairs while injured?") then
    crawl.do_commands({"CMD_GO_DOWNSTAIRS"})
  end
end

-- =========================
-- AUTOINSCRIPTION
-- =========================

local inscription_properties = {
  Will = true, rC = true, rF = true, rN = true,
  Regen = true, Stlth = true,
  Str = true, Int = true, Dex = true, Slay = true,
  EV = true, AC = true, MP = true,
  rCorr = true, rElec = true, rMut = true, rPois = true,
  rSteam = true, rTorment = true, rDrown = true,
  Ice = true, Fire = true,
  sInv = true, flight = true,
};

-- Relies on stash annotation
-- See https://github.com/crawl/crawl/blob/master/crawl-ref/source/dat/clua/stash.lua
local function FindItemProperties(description)
  local prefixes = description:match("Stash search prefixes:%s*(.-)\nMenu/colouring prefixes:")
    or description:match("Stash search prefixes:%s*(.*)")
  if not prefixes then
    return nil
  end

  -- Find an item's properties by searching their description
  local properties, seen = {}, {}
  for group in prefixes:gmatch("{([^{}]*)}") do
    for token in group:gmatch("%S+") do
      local base = token:match("^([%a]+)[+-]*%d*$")
      if inscription_properties[base] and not seen[token] then
        properties[#properties + 1] = token
        seen[token] = true
      end
    end
  end
  return properties
end

local talisman_property_order = {
  "rF", "rC", "rPois", "rN", "rElec", "rCorr", "Will",
  "Str", "Int", "Dex", "Stlth",
};
local talisman_property_aliases = {rNeg = "rN", Stealth = "Stlth"}
local talisman_property_types = {
  rF = "resist", rC = "resist", rPois = "resist", rN = "resist",
  rElec = "resist", rCorr = "resist", Will = "resist",
  Str = "stat", Int = "stat", Dex = "stat", Stlth = "stealth",
};

-- Extract talisman properties from their description
-- Overcomplicated much?
local function FindTalismanProperties(description)
  local plain = description:gsub("<[^>]*>", ""):gsub("\r", "")
  local block = plain:match("\n%s*Cur%s+[^\n]*\n(.*)")
  if not block then
    return nil
  end

  local values, started = {}, false
  for line in (block .. "\n"):gmatch("([^\n]*)\n") do
    if line:match("^%s*Melds:") or line:match("^%s*Mutations") then
      break
    end
    if not line:match("%S") then
      if started then
        break
      end
    else
      if not line:match("^%s*[%a ]+:") then
        break
      end
      if not line:match("^%s*Class:") then
        started = true
      end
      for label, value in line:gmatch("(%a+):%s*(%S+)") do
        local key = talisman_property_aliases[label] or label
        local kind = talisman_property_types[key]
        if kind then
          if kind == "stat" then
            if not value:match("^[+-]%d+$") then
              return nil
            end
            value = tonumber(value) ~= 0 and value or ""
          elseif kind == "resist" and (value == "∞" or value == "inf") then
            value = "∞"
          else
            if not value:match("^[+x.%-]+$") then
              return nil
            end
            value = value:gsub("%.", ""):gsub("x", "-")
          end
          if values[key] and values[key] ~= value then
            return nil
          end
          values[key] = value
        end
      end
    end
  end

  local properties = {}
  for _, key in ipairs(talisman_property_order) do
    if values[key] and values[key] ~= "" then
      properties[#properties + 1] = key .. values[key]
    end
  end
  return properties
end

-- Autoinscribe items with their properties
function AutoInscribe()
  for _, item_list in ipairs({items.inventory(), you.floor_items() or {}}) do
    for _, item in ipairs(item_list) do
      if not item.artefact then
        local properties
        if item.class(true) == "talisman" then
          properties = FindTalismanProperties(item.description or "")
        else
          properties = FindItemProperties(item.description or "")
        end

        if properties then
          local inscription = table.concat(properties, " ")
          if item.inscription ~= inscription then
            item.inscribe(inscription, false)
          end
        end
      end
    end
  end
end

-- =========================
-- SPELLCASTING
-- =========================

-- Repurpose (w)ield for spellcasting, but only for felids
function FelidZE()
  if you.race() == "Felid" then
    crawl.sendkeys("ze")
  else
    crawl.do_commands({"CMD_WIELD_WEAPON"})
  end
end

-- =========================
-- SKILLS
-- =========================

-- Opens skill menu at the beginning of the game
local need_skills_opened = true
function OpenSkills()
  if you.turns() == 0 and need_skills_opened then
    need_skills_opened = false
    crawl.sendkeys("m")
  end
end

-- =========================
-- HOOKS
-- =========================

function c_message(text, channel)
  NoteFadedAltar(text)
  IssueMessageWarnings(text)
end
 
function ready()
  OpenSkills()
  WarnThreats()
  AnnounceDamage()

  MarkReturnStair()
  ShoutWalkManager()
  AutoInscribe()
end
}


