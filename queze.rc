######################################################################
#                          General Settings                          #
######################################################################

# Sets skill training to manual
default_manual_training = true

# Use old inventory layout
show_paged_inventory = false

# Travel & resting
travel_delay = -1
explore_delay = -1
rest_delay = -1
rest_wait_both = true
explore_stop += greedy_items
travel_key_stop = false
travel_open_doors = true
show_travel_trail = true

# Autopickup
autopickup = $?!+"/♦%
drop_disables_autopickup = true

# Controls the speed of animations (default: 600)
view_delay = 100

autofight_stop = 70

hp_colour = 100:green, 99:lightgrey, 75:yellow, 50:lightred, 25:red
mp_colour = 100:green, 99:lightgrey, 75:yellow, 50:lightred, 25:red
tile_show_threat_levels = tough, nasty, unusual

# Increase font size when playing offline
tile_font_msg_size = 16

show_more = false
force_more_message += into view
force_more_message += Your unholy channel is weakening.
force_more_message += Found a staircase to the Ecumenical Temple

confirm_action += Death's Door
confirm_action += Revivification
confirm_action += Silence
confirm_action += Torment
confirm_action += Blink
confirm_action += Rending Blade

unusual_monster_items += vulnerable:venom:7
force_spell_targeter += Animate Dead
force_spell_targeter += Iskenderun's Mystic Blast
force_spell_targeter += Malign Gateway
force_spell_targeter += Ozocubu's Refrigeration
force_spell_targeter += Permafrost Eruption

######################################################################
#                             Spell Slots                            #
######################################################################

# Set Alias for Spell Slots
slot := spell_slot

slot += Fireball:f
slot += Apportation:g
slot += Slow:s
slot += Swiftness:s
slot += Passwall:w
slot += Mephitic Cloud:x
slot += Vampiric Draining:x
slot += Iskenderun's Battlesphere:z
slot += Lee's Rapid Deconstruction:z
slot += Animate Dead:A
slot += Ozocubu's Armour:A
slot += Death's Door:D
slot += Borgnjor's Revivification:R

######################################################################
#                           Character Dump                           #
######################################################################
note_chat_messages = true
note_hp_percent = 25
note_all_skill_levels = true
user_note_prefix = --
note_items += experience,of resistance, Archmagi
note_items += crystal plate armour,pearl dragon scales
note_items += artefact
note_messages += You feel monstrous
note_messages += You pass through the gate
note_messages += cast .* Abyss

#################################
# damage announcements messages #
# HDamage.rc                    #
# Updated 05-10-2025 57f0e26    #
#################################

<
  local previous_hp = 0
  local previous_mp = 0
  local previous_form = ""
  local was_berserk_last_turn = false

  function AnnounceDamage()
    local current_hp, max_hp = you.hp()
    local current_mp, max_mp = you.mp()
    --Things that increase hp/mp temporarily really mess with this
    local current_form = you.transform()
    local you_are_berserk = you.berserk()
    local max_hp_increased = false
    local max_hp_decreased = false

    if (current_form ~= previous_form) then
      if (previous_form:find("dragon") or
          previous_form:find("statue") or
          previous_form:find("tree") or
          previous_form:find("ice")) then
        max_hp_decreased = true
      elseif (current_form:find("dragon") or
          current_form:find("statue") or
          current_form:find("tree") or
          current_form:find("ice")) then
        max_hp_increased = true
      end
    end
    if (was_berserk_last_turn and not you_are_berserk) then
      max_hp_decreased = true
    elseif (you_are_berserk and not was_berserk_last_turn) then
      max_hp_increased = true
    end

    --crawl.mpr(string.format("previous_form is: %s", previous_form))
    --crawl.mpr(string.format("current_form is: %s", current_form))
    --crawl.mpr(string.format("max_hp_increased is: %s", max_hp_increased and "True" or "False"))
    --crawl.mpr(string.format("max_hp_decreased is: %s", max_hp_decreased and "True" or "False"))

    --crawl.mpr(string:format("you_are_berserk is: %s", you_are_berserk and "True" or "False"))
    --crawl.mpr(string:format("was_berserk_last_turn is: %s", was_berserk_last_turn and "True" or "False"))


    --Skips message on initializing game
    if previous_hp > 0 then
      local hp_difference = previous_hp - current_hp
      local mp_difference = previous_mp - current_mp

      if max_hp_increased or max_hp_decreased then
        if max_hp_increased then
          crawl.mpr("<green>You now have " .. current_hp .. "/" .. max_hp .. " hp.</green>")
        else
          crawl.mpr("<yellow>You now have " .. current_hp .. "/" .. max_hp .. " hp.</yellow>")
        end
      else
        --On losing health
        if (current_hp < previous_hp) then
          if current_hp <= (max_hp * 0.30) then
            crawl.mpr("<red>You take " .. hp_difference .. " damage,</red><lightred> and have " .. current_hp .. "/" .. max_hp .. " hp.</lightred>")
          elseif current_hp <= (max_hp * 0.50) then
            crawl.mpr("<red>You take " .. hp_difference .. " damage, and have " .. current_hp .. "/" .. max_hp .. " hp.</red>")
          elseif current_hp <= (max_hp *  0.70) then
            crawl.mpr("<red>You take " .. hp_difference .. " damage,</red><yellow> and have " .. current_hp .. "/" .. max_hp .. " hp.</yellow>")
          elseif current_hp <= (max_hp * 0.90) then
            crawl.mpr("<red>You take " .. hp_difference .. " damage,</red><lightgrey> and have " .. current_hp .. "/" .. max_hp .. " hp.</lightgrey>")
          else
            crawl.mpr("<red>You take " .. hp_difference .. " damage,</red><green> and have " .. current_hp .. "/" .. max_hp .. " hp.</green>")
          end
          if hp_difference > (max_hp * 0.20) then
            crawl.mpr("<lightred>MASSIVE DAMAGE!!</lightred>")
          end
        end

        --On gaining more than 1 health
        if (current_hp > previous_hp) then
          --Removes the negative sign
          local health_inturn = (0 - hp_difference)
          if (health_inturn > 1) and not (current_hp == max_hp) then
            if current_hp <= (max_hp * 0.30) then
              crawl.mpr("<green>You regained " .. health_inturn .. " hp,</green><lightred> and now have " .. current_hp .. "/" .. max_hp .. " hp.</lightred>")
            elseif current_hp <= (max_hp * 0.50) then
              crawl.mpr("<green>You regained " .. health_inturn .. " hp,</green><red> and now have " .. current_hp .. "/" .. max_hp .. " hp.</red>")
            elseif current_hp <= (max_hp *  0.70) then
              crawl.mpr("<green>You regained " .. health_inturn .. " hp,</green><yellow> and now have " .. current_hp .. "/" .. max_hp .. " hp.</yellow>")
            elseif current_hp <= (max_hp * 0.90) then
              crawl.mpr("<green>You regained " .. health_inturn .. " hp,</green><lightgrey> and now have " .. current_hp .. "/" .. max_hp .. " hp.</lightgrey>")
            else
              crawl.mpr("<green>You regained " .. health_inturn .. " hp, and now have " .. current_hp .. "/" .. max_hp .. " hp.</green>")
            end
          end
          if (current_hp == max_hp) then
            crawl.mpr("<green>Health restored: " .. current_hp .. "</green>")
          end
        end

        --On gaining more than 1 magic
        if (current_mp > previous_mp) then
          --Removes the negative sign
          local mp_inturn = (0 - mp_difference)
          if (mp_inturn > 1) and not (current_mp == max_mp) then
            if current_mp < (max_mp * 0.25) then
              crawl.mpr("<lightcyan>You regained " .. mp_inturn .. " mp,</lightcyan><red> and now have " .. current_mp .. "/" .. max_mp .. " mp.</red>")
            elseif current_mp < (max_mp * 0.50) then
              crawl.mpr("<lightcyan>You regained " .. mp_inturn .. " mp,</lightcyan><yellow> and now have " .. current_mp .. "/" .. max_mp .. " mp.</yellow>")
            else
              crawl.mpr("<lightcyan>You regained " .. mp_inturn .. " mp,</lightcyan><green> and now have " .. current_mp .. "/" .. max_mp .. " mp.</green>")
            end
          end
          if (current_mp == max_mp) then
            crawl.mpr("<lightcyan>MP restored: " .. current_mp .. "</lightcyan>")
          end
        end

        --On losing magic
        if current_mp < previous_mp then
          if current_mp <= (max_mp / 5) then
            crawl.mpr("<lightcyan>You now have </lightcyan><red>" .. current_mp .. "/" ..max_mp .." mp.</red>")
          elseif current_mp <= (max_mp / 2) then
            crawl.mpr("<lightcyan>You now have </lightcyan><yellow>" .. current_mp .. "/" ..max_mp .." mp.</yellow>")
          else
            crawl.mpr("<lightcyan>You now have </lightcyan><green>" .. current_mp .. "/" ..max_mp .." mp.</green>")
          end
        end
      end
    end

    --Set previous hp/mp and form at end of turn
    previous_hp = current_hp
    previous_mp = current_mp
    previous_form = current_form
    was_berserk_last_turn = you_are_berserk
  end
>

######################################################################
#                        Custom Lua Functions                        #
######################################################################

{
-- =========================
-- HELPER FUNCTIONS
-- =========================

-- Helper function to check if a list contains a value
function contains(list, value)
  for _, v in ipairs(list) do
    if v == value then
      return true
    end
  end
  return false
end

-- Helper function generating all coords in LOS
function LOSCoords()
  local coords = {}
  for x = -you.los(), you.los() do
    for y = -you.los(), you.los() do
	  table.insert(coords, {x = x, y = y})
	end
  end
  return coords
end

-- Helper function returning true if a hostile creature is in LOS
function IsEnemyInLOS()
  for _, c in ipairs(LOSCoords()) do
    local m = monster.get_monster_at(c.x, c.y)
    -- 0 = hostile, 1 = neutral, 2 = strict neutral, 3 = good neutral, 4 = friendly
    if m and m:attitude() < 1 and not m:is_safe() then
      return true
    end
  end
  return false
end

-- Helper function which finds a message in the buffer containing a pattern
-- If a subsequent message matches the stop pattern, return nil
function FindMessage(match, stop)
  local counter = 1
  -- Check at most 100 messages
  while (counter < 100)
  do
    local message = crawl.messages(counter)
    counter = counter + 1

    if string.find(message, match) then
      return message
    end
    if string.find(message, stop) then
      return
    end
  end
end

-- Helper function returning true if you are completely rested
function IsHealthy()
  local hp, mhp = you.hp()
  local mp, mmp = you.mp()
  if hp < mhp then
    return false
  elseif mp < mmp then
    return false
  elseif you.contamination() > 0 then
    return false
  end
  return true
end

-- Helper function returning true if a feature is an upstair
function IsUpstair(feature)
  if feature == nil then
    return false
  elseif string.find(feature, "stairs_up") then
    return true
  elseif string.find(feature, "escape_hatch_up") then
    return true
  elseif string.find(feature, "exit_") then
    return true
  end
  return false
end

-- Helper function returning true if a feature is an downstair 
function IsDownstair(feature)
  if feature == nil then
    return false
  elseif string.find(feature, "stairs_down") then
    return true
  elseif string.find(feature, "escape_hatch_down") then
    return true
  elseif string.find(feature, "enter_") then
    return true
  end
  return false
end

-- Helper function returning true if it's safe to autoexplore
function IsSafe()
  local feature = view.feature_at(0, 0)
  if IsUpstair(feature) then
    return true
  end

  local hp, mhp = you.hp()
  local mp, mmp = you.mp()
  return hp == mhp and mp == mmp
end

-- =========================
-- MACROS
-- =========================

local retreated = false

function SafeExplore()
  -- Do not allow exploring if you have a sentinel's mark
  -- Not sure if you.status() works now
  if FindMessage("mark forms upon you", "mark upon you fades away") then
    crawl.mpr("<lightred>A sentinel's mark is upon you!</lightred>")
	
  elseif IsSafe() or retreated then
    crawl.do_commands({"CMD_EXPLORE"})
    retreated = false
  
  else
    retreated = true
  
    -- If possible, retreat to a stair
    for _, c in ipairs(LOSCoords()) do
      if IsUpstair(view.feature_at(c.x, c.y)) then
	    crawl.sendkeys("X<")
		return
	  end
	end  

    -- Otherwise, open level map
    crawl.sendkeys("X")
  end
end

-- Repurpose (w)ield for spellcasting, but only for felids
function FelidZF()
  if you.race() == "Felid" then
    crawl.sendkeys("zf")
  else
    crawl.do_commands({"CMD_WIELD_WEAPON"})
  end
end

-- Shout before walking and stop if any monsters shout back
local ask_for_confirmation = true
local noise_warning = false
local last_action
local next_direction

-- Create a shout walk function for a direction
function ShoutWalkCreator(direction)
  return function()
    -- Do not shout walk if monsters are in LOS
    if IsEnemyInLOS() then
      crawl.mpr("There are monsters nearby!", 5)
      return
    end

    -- If a monster has made a noise in the last shout walk, prompt whether to shout walk anyway
    if noise_warning then
      if not crawl.yesno("Your last walk was canceled because a monster made a noise. Continue anyway?") then
        return
      end
    end

    -- Shout walking is dangerous, ask to confirm
    if ask_for_confirmation then
      if not crawl.yesno("Really shout walk? This will wake up nearby monsters!") then
        return
      end
      ask_for_confirmation = false
    end

    -- Shout, then set direction for next turn
    crawl.sendkeys("tt")
    last_action = "shout"
    next_direction = direction
  end
end


-- Manages the state tracking
function ShoutWalkManager()
  local direction = next_direction
  local action = last_action
  noise_warning = false
  next_direction = nil
  last_action = nil

  -- Ask for confirmation again between shout walks
  if action == nil then
    ask_for_confirmation = true
  end

  -- Skip if no direction was set, or if we didn't shout last turn
  if direction == nil or action ~= "shout" then
    return
  end
  
  -- Abort if an enemy is in LOS
  if IsEnemyInLOS() then
    crawl.mpr("A monster has walked into LOS. Walk canceled.", 3)
    return
  end

  -- Abort if a noise was made
  local noise_made = FindMessage("You hear", "for attention")
  if noise_made then
    crawl.mpr("A noise has been made in response. Walk canceled.", 3)
    noise_warning = true
    return
  end
  
  -- Walk in the direction set last turn
  crawl.sendkeys(direction)
  last_action = "walk"
end

function ShoutWalkMapper()
  shout_walk_y = ShoutWalkCreator("y")
  shout_walk_u = ShoutWalkCreator("u")
  shout_walk_h = ShoutWalkCreator("h")
  shout_walk_b = ShoutWalkCreator("b")
  shout_walk_n = ShoutWalkCreator("n")
  shout_walk_j = ShoutWalkCreator("j")
  shout_walk_k = ShoutWalkCreator("k")
  shout_walk_l = ShoutWalkCreator("l")
end

-- Set up shout walk functions
ShoutWalkMapper()


-- Setup for excluding return stairs, if enemies were in LOS
local mark_return_stair

function SafeUpstairs()
  local feature = view.feature_at(0, 0)
  mark_return_stair = IsUpstair(feature) and IsEnemyInLOS()
  crawl.do_commands({"CMD_GO_UPSTAIRS"})
end


-- Prompt when going downstairs in dangerous situations
function SafeDownstairs()
  if not IsDownstair(view.feature_at(0, 0)) then
    crawl.do_commands({"CMD_GO_DOWNSTAIRS"})
    return
  end

  local branch = you.branch()
  local depth = you.depth()
  local deepest_current = travel.find_deepest_explored(branch) or 0
  local deepest_depths = travel.find_deepest_explored("Depths") or 0

  -- Prevent going to Vaults:5 before Depths
  if branch == "Vaults" and depth == 4 and deepest_depths > 0 then
    crawl.mpr("<lightred>Visit Depths before doing Vaults:5, please.</lightred>")
    return
  end

  -- Warn before going to V:5 for the first time
  if branch == "Vaults" and depth == 4 and deepest_current < 5 then
    if crawl.yesno("Are you really prepared to enter Vaults:5?") then
      crawl.do_commands({"CMD_GO_DOWNSTAIRS"})
    end
  end

  local s_branches = {"Shoals", "Swamp", "Snake", "Spider"}
  local in_s_branch = contains(s_branches, branch)

  -- Warn before entering the fourth floor of an S-branch for the first time before exploring another
  if in_s_branch and depth == 3 and deepest_current < 4 then
    local explored_another_s_branch = false
    for _, s_branch in ipairs(s_branches) do
      if s_branch ~= branch and (travel.find_deepest_explored(s_branch) or 0) > 0 then
        explored_another_s_branch = true
        break
      end
    end

    if not explored_another_s_branch then
      if crawl.yesno("Really go downstairs to the last level before exploring another S-branch?") then
        crawl.do_commands({"CMD_GO_DOWNSTAIRS"})
      end
      return
    end
  end

  if IsHealthy() then
    crawl.do_commands({"CMD_GO_DOWNSTAIRS"})
  elseif crawl.yesno("Really go downstairs while injured?") then
    crawl.do_commands({"CMD_GO_DOWNSTAIRS"})
  end
end


-- =========================
-- CUSTOM HOOKS
-- =========================

-- Opens skill menu at the beginning of the game
local need_skills_opened = true
function OpenSkills()
  if you.turns() == 0 and need_skills_opened then
    need_skills_opened = false
    crawl.sendkeys("m")
  end
end

-- Exclude a downstair, if enemies were in LOS when going upstairs
function MarkReturnStair()
  if not mark_return_stair then
    return
  end

  if IsDownstair(view.feature_at(0, 0)) then
    crawl.mpr("<lightred>Return stair excluded. Enemies were in view.</lightred>")
    travel.set_exclude(0, 0, 0)
  end

  mark_return_stair = false
end
 
function ready()
  AnnounceDamage()
  OpenSkills()

  MarkReturnStair()
  ShoutWalkManager()
end
}


