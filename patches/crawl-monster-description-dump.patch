@@ -220,4 +222,35 @@
 _loading_message("Loading databases...");
 databaseSystemInit();
+// Test hook used by the dcss-rc GitHub Action. The monster_info constructor
+// and description formatter are the same ones used by mons:desc(true).
+if (const char *dump_path = std::getenv("DCSS_MONSTER_DESCRIPTION_DUMP"))
+{
+    std::ofstream dump(dump_path);
+    if (!dump)
+        end(1, false, "Could not open monster description dump: %s\n", dump_path);
+
+    int written = 0;
+    for (int i = 0; i < NUM_MONSTERS; ++i)
+    {
+        const monster_type type = static_cast<monster_type>(i);
+        if (!get_monster_data(type))
+            continue;
+
+        const monster_info info(type);
+        describe_info description;
+        bool has_stat_desc;
+        get_monster_db_desc(info, description, has_stat_desc);
+        const string body = description.body.str();
+        if (body.empty())
+            continue;
+
+        dump << "===== " << mons_type_name(type, DESC_PLAIN) << " (" << i
+             << ") =====\n" << body << "\n\n";
+        ++written;
+    }
+    if (!dump || written == 0)
+        end(1, false, "Monster description dump produced no entries\n");
+    end(0, false, "Wrote %d monster descriptions to %s\n", written, dump_path);
+}
_loading_message("Loading spells and features...");
init_feat_desc_cache();
